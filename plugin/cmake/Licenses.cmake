# Preserve upstream notices without choosing a licence for the user's source code.
set(license_directory "${CMAKE_CURRENT_BINARY_DIR}/licenses")
file(MAKE_DIRECTORY "${license_directory}")
function(copy_juce_notice source destination)
    configure_file("${CREST_JUCE_ROOT}/${source}" "${license_directory}/${destination}" COPYONLY)
endfunction()
copy_juce_notice("LICENSE.md" "JUCE.md")
copy_juce_notice("modules/juce_audio_processors_headless/format_types/VST3_SDK/LICENSE.txt" "VST3.txt")
copy_juce_notice("modules/juce_core/zip/zlib/README" "zlib.txt")
copy_juce_notice("modules/juce_graphics/fonts/harfbuzz/COPYING" "HarfBuzz.txt")
copy_juce_notice("modules/juce_graphics/unicode/sheenbidi/LICENSE" "SheenBidi.txt")
copy_juce_notice("modules/juce_graphics/image_formats/pnglib/LICENSE" "libpng.txt")
copy_juce_notice("modules/juce_graphics/image_formats/jpglib/README" "libjpeg.txt")
copy_juce_notice("modules/juce_audio_formats/codecs/flac/Flac Licence.txt" "FLAC.txt")
copy_juce_notice("modules/juce_audio_formats/codecs/oggvorbis/Ogg Vorbis Licence.txt" "OggVorbis.txt")
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/../node_modules/marked/LICENSE.md" "${license_directory}/Marked.md" COPYONLY)
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/../node_modules/vexflow/LICENSE" "${license_directory}/VexFlow.txt" COPYONLY)
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/THIRD_PARTY.md" "${license_directory}/README.md" COPYONLY)
execute_process(COMMAND go env GOROOT OUTPUT_VARIABLE go_root OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(EXISTS "${go_root}/LICENSE")
    configure_file("${go_root}/LICENSE" "${license_directory}/Go.txt" COPYONLY)
else()
    # Homebrew installs this notice beside libexec rather than inside GOROOT.
    configure_file("${go_root}/../LICENSE" "${license_directory}/Go.txt" COPYONLY)
endif()
